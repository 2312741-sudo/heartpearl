rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function blockedBy(userId, otherUserId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && otherUserId in get(/databases/$(database)/documents/users/$(userId)).data.get('blockedUsers', []);
    }

    function interactionAllowed(firstUserId, secondUserId) {
      return firstUserId == secondUserId ||
        (!blockedBy(firstUserId, secondUserId) &&
         !blockedBy(secondUserId, firstUserId));
    }

    function directChatAllowed(chatData) {
      return signedIn()
        && chatData.participants is list
        && chatData.participants.size() == 2
        && request.auth.uid in chatData.participants
        && interactionAllowed(
          request.auth.uid,
          chatData.participants[0] == request.auth.uid
            ? chatData.participants[1]
            : chatData.participants[0]
        );
    }

    function validLocationDocument(userId, locationData) {
      return locationData.keys().hasOnly([
          'ownerUid', 'geo', 'lat', 'lng', 'updatedAt', 'capturedAt', 'accuracy',
          'speed', 'batteryLevel', 'isSharing', 'isOnline', 'liveSessionActive',
          'shareExpiresAt', 'shareDurationLabel', 'currentPlaceType',
          'currentPlaceLabel', 'arrivedAt', 'allowedViewers'
        ])
        && locationData.ownerUid == userId
        && locationData.updatedAt == request.time
        && (!('geo' in locationData) || locationData.geo is latlng)
        && (!('lat' in locationData) || locationData.lat is number)
        && (!('lng' in locationData) || locationData.lng is number)
        && (!('capturedAt' in locationData) || locationData.capturedAt is timestamp)
        && (!('accuracy' in locationData) || (
          locationData.accuracy is number
          && locationData.accuracy > 0
          && locationData.accuracy <= 200
        ))
        && (!('speed' in locationData) || (
          locationData.speed is number
          && locationData.speed >= 0
          && locationData.speed <= 200
        ))
        && (!('batteryLevel' in locationData) || (
          locationData.batteryLevel is number
          && locationData.batteryLevel >= 0
          && locationData.batteryLevel <= 100
        ))
        && (!('isSharing' in locationData) || locationData.isSharing is bool)
        && (!('isOnline' in locationData) || locationData.isOnline is bool)
        && (!('liveSessionActive' in locationData) || locationData.liveSessionActive is bool)
        && (!('shareExpiresAt' in locationData) || locationData.shareExpiresAt is timestamp)
        && (!('shareDurationLabel' in locationData) || locationData.shareDurationLabel is string)
        && (!('currentPlaceType' in locationData) || locationData.currentPlaceType is string)
        && (!('currentPlaceLabel' in locationData) || locationData.currentPlaceLabel is string)
        && (!('arrivedAt' in locationData) || locationData.arrivedAt is timestamp)
        && (!('allowedViewers' in locationData) || (
          locationData.allowedViewers is list
          && locationData.allowedViewers.size() <= 500
        ));
    }

    function mayReadLocation(userId, locationData) {
      let owner = get(/databases/$(database)/documents/users/$(userId));
      return request.auth.uid == userId || (
        exists(/databases/$(database)/documents/users/$(userId))
        && locationData.get('isSharing', false) == true
        && request.auth.uid in owner.data.get('friends', [])
        && interactionAllowed(request.auth.uid, userId)
        && (
          locationData.get('allowedViewers', []).size() == 0
          || request.auth.uid in locationData.get('allowedViewers', [])
        )
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
      );

      match /places/{placeId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }
    match /photos/{photoId} {
      // Inbox queries contain photos from multiple senders, so visibility is
      // filtered in the app providers. Per-document writes remain protected.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if signedIn() && interactionAllowed(request.auth.uid, resource.data.senderId);
      allow delete: if request.auth != null;
    }
    match /friendRequests/{requestId} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{notifId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && interactionAllowed(
          request.resource.data.senderId,
          request.resource.data.userId
        );
      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.senderId == request.auth.uid
      );
    }
    match /chats/{chatId} {
      allow read: if signedIn();
      allow create: if directChatAllowed(request.resource.data);
      allow update: if directChatAllowed(resource.data)
        && directChatAllowed(request.resource.data)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && directChatAllowed(
            getAfter(/databases/$(database)/documents/chats/$(chatId)).data
          );
        allow update, delete: if false;
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }
    match /userLocations/{userId} {
      // Clients subscribe directly to known friend document IDs. Collection
      // queries are denied because Security Rules are not result filters.
      allow get: if signedIn() && mayReadLocation(userId, resource.data);
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validLocationDocument(userId, request.resource.data);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
